# Runtime
NODE_ENV=production
PORT=3000

# MySQL / Drizzle
DATABASE_URL=mysql://pagina_lucrativa:troque-esta-senha@db:3306/pagina_lucrativa

# Local password authentication must be explicitly enabled. Demo accounts NEVER work in production.
ENABLE_LOCAL_AUTH=false
PUBLIC_APP_ORIGIN=https://seu-dominio.example.com
# Must be private and outside releases and LOCAL_STORAGE_DIR
SECURITY_AUDIT_DIR=/var/lib/pagina-lucrativa/audit

# Session and application identity
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
VITE_APP_ID=seu-app-id
OWNER_OPEN_ID=seu-owner-open-id

# OAuth, when enabled by the deployment environment
OAUTH_SERVER_URL=https://seu-oauth.example.com
VITE_OAUTH_PORTAL_URL=https://seu-portal-oauth.example.com

# Built-in Forge integration, only when used by the deployment
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional local storage path used by the project
LOCAL_STORAGE_DIR=/app/.local-storage

# Docker Compose MySQL credentials
MYSQL_DATABASE=pagina_lucrativa
MYSQL_USER=pagina_lucrativa
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
